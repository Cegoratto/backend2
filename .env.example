# Локальный PostgreSQL (без Docker)
# Установите PostgreSQL: https://www.postgresql.org/download/windows/
# Создайте БД: createdb kanban  (или через pgAdmin)

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kanban

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

# OPENROUTER_API_KEY — из backend/.dev.vars
OPENROUTER_API_KEY=your_openrouter_api_key_here

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
