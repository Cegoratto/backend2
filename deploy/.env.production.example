# Production env for DigitalOcean droplet (copy to /opt/kanban-backend/.env)

DATABASE_URL=sqlite+aiosqlite:///./data/kanban.db

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=1440

OPENROUTER_API_KEY=sk-or-v1-...

# Frontend origins (add your Cloudflare Pages URL if used)
CORS_ORIGINS=https://slava.vevi.monster,http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=https://slava.vevi.monster

GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_TEAM=price_...
